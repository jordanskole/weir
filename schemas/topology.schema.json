{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weir topology",
  "type": "object",
  "required": [
    "input",
    "output",
    "terminals",
    "wiring"
  ],
  "properties": {
    "input": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "allOf": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "allOf"
          ],
          "additionalProperties": false
        }
      ]
    },
    "output": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "oneOf": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "oneOf"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "allOf": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "allOf"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "many": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "many"
          ],
          "additionalProperties": false
        }
      ]
    },
    "terminals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "wiring": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/topologyNode"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "topologyNode": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "then": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/topologyNode"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
