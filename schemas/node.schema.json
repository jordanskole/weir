      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "oneOf": {
