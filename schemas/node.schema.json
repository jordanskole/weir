    "closure": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "expected": {}
          },
          "required": [
            "expected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {}
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
