label: Gather Ingredients
description: Confirms every ingredient is on hand before cooking begins
input: Recipe
output: Recipe
examples:
  - given:
      Recipe:
        title: "Chocolate Chip Cookies"
        servings: 24
        temperature: 375
        ingredients:
          Butter:
            name: "Butter"
            amount: "1 cup, softened"
          Flour:
            name: "Flour"
            amount: "2 1/4 cups"
          Chocolate Chips:
            name: "Chocolate Chips"
            amount: "2 cups"
    expect:
      Recipe:
        title: "Chocolate Chip Cookies"
        servings: 24
        temperature: 375
        ingredients:
          Butter:
            name: "Butter"
            amount: "1 cup, softened"
          Flour:
            name: "Flour"
            amount: "2 1/4 cups"
          Chocolate Chips:
            name: "Chocolate Chips"
            amount: "2 cups"
