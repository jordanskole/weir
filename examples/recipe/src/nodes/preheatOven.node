label: Preheat Oven
description: Starts heating the oven to the recipe's target temperature, while the dough gets mixed
input: Recipe
output: Oven
examples:
  - given:
      Recipe:
        title: "Chocolate Chip Cookies"
        servings: 24
        temperature: 375
        ingredients:
          Butter:
            name: "Butter"
            amount: "1 cup, softened"
          Flour:
            name: "Flour"
            amount: "2 1/4 cups"
          Chocolate Chips:
            name: "Chocolate Chips"
            amount: "2 cups"
    expect:
      Oven:
        temperature: 375
        preheated: true
