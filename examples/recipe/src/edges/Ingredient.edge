label: Ingredient
description: A single ingredient in a recipe, with how much of it is needed
index: name
fields:
  name:
    type: utf8
    label: Name
    description: The ingredient's name
    nullable: false
    validations:
      minLength: 1
      maxLength: 100
  amount:
    type: utf8
    label: Amount
    description: How much of this ingredient is needed, written as it would appear on the recipe (e.g. "2 cups")
    nullable: false
    validations:
      minLength: 1
      maxLength: 50
