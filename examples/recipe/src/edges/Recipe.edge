label: Recipe
description: A dish and its ingredients, before cooking has started
fields:
  title:
    type: utf8
    label: Title
    description: The name of the dish
    nullable: false
    validations:
      minLength: 3
      maxLength: 200
  servings:
    type: uint8
    label: Servings
    description: How many servings this recipe makes
    nullable: false
    validations:
      min: 1
      max: 100
  temperature:
    type: uint16
    label: Temperature
    description: The oven temperature this recipe calls for, in Fahrenheit
    nullable: false
    validations:
      min: 200
      max: 500
  ingredients:
    many: Ingredient
