label: Add Todo To List
description: Adds a task to a todo list
input:
  every:
    - TodoList
    - Todo
output:
  TodoList
examples:
  - given:
      TodoList:
        title: "Grocery List"
        description: "A list of groceries to buy"
        tasks: {}
      Todo:
        id: "todo-1"
        title: "Buy milk and eggs"
        description: "Get 2% milk from the store"
        is_complete: false
    expect:
      TodoList:
        title: "Grocery List"
        description: "A list of groceries to buy"
        tasks:
          todo-1:
            id: "todo-1"
            title: "Buy milk and eggs"
            description: "Get 2% milk from the store"
            is_complete: false
