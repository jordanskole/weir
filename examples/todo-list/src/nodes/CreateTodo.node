label: Create Todo
description: Creates a new task
input: NewTodo
output: Todo
examples:
  - given:
      NewTodo:
        id: "todo-1"
        title: "Buy milk and eggs"
        description: "Get 2% milk from the store"
        is_complete: false
    expect:
      Todo:
        id: "todo-1"
        title: "Buy milk and eggs"
        description: "Get 2% milk from the store"
        is_complete: false
