label: Todo
description: A task a person needs to do, or has done
index: id
fields:
  "...TodoInput":
  id:
    minted: uuid
    label: ID
    description: A stable identifier for this task, unique within its list
  is_complete:
    type: bool # bool is the only type that can't be nullable — see types.ts's FieldDef doc
    label: Is Complete
    description: Whether the task has been completed
