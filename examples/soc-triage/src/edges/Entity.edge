label: Entity
description: One entity pulled out of an alert — the thing each investigation branch is about
index: id
fields:
  id:
    type: utf8
    label: Entity ID
    description: Stable identifier for this entity within the alert
    nullable: false
    validations:
      minLength: 1
      maxLength: 100
  kind:
    type: utf8
    label: Kind
    description: What sort of entity this is (principal, asset)
    nullable: false
    validations:
      minLength: 1
      maxLength: 50
  value:
    # The actual identifier — a principal's account name or an asset's hostname.
    # Labelled because this is what leaves for the third-party enrichment zone,
    # which is exactly the question design.md §7 wants answerable.
    classification: pii
    type: utf8
    label: Value
    description: The entity's concrete value — the account name, the hostname
    nullable: false
    validations:
      minLength: 1
      maxLength: 200
