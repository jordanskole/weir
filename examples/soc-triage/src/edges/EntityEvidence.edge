label: Entity Evidence
description: Both investigation branches for one entity, joined — the fan-in's output
fields:
  entityId:
    type: utf8
    label: Entity ID
    description: The entity both branches were about
    nullable: false
    validations:
      minLength: 1
      maxLength: 100
  identitySummary:
    type: utf8
    label: Identity Summary
    description: What the identity branch found
    nullable: false
    validations:
      minLength: 1
      maxLength: 500
  assetSummary:
    type: utf8
    label: Asset Summary
    description: What the asset branch found
    nullable: false
    validations:
      minLength: 1
      maxLength: 500
