label: Assessment
description: A verdict reached for one entity, from evidence that descends from it
fields:
  entityId:
    type: utf8
    label: Entity ID
    description: The entity this verdict is about
    nullable: false
    validations:
      minLength: 1
      maxLength: 100
  verdict:
    type: utf8
    label: Verdict
    description: The triage conclusion for this entity
    nullable: false
    validations:
      minLength: 1
      maxLength: 200
