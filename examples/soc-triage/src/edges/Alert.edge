label: Alert
description: A security alert entering investigation — one alert is one external event, so one run
fields:
  id:
    type: utf8
    label: Alert ID
    description: The alerting system's identifier for this alert
    nullable: false
    validations:
      minLength: 1
      maxLength: 100
  principal:
    type: utf8
    label: Principal
    description: The user or service account the alert names
    nullable: false
    validations:
      minLength: 1
      maxLength: 200
  asset:
    type: utf8
    label: Asset
    description: The host or resource the alert names
    nullable: false
    validations:
      minLength: 1
      maxLength: 200
