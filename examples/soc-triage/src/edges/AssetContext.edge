label: Asset Context
description: Asset evidence gathered for one entity
fields:
  entityId:
    type: utf8
    label: Entity ID
    description: The entity this evidence is about
    nullable: false
    validations:
      minLength: 1
      maxLength: 100
  summary:
    type: utf8
    label: Summary
    description: What the asset lookup found
    nullable: false
    validations:
      minLength: 1
      maxLength: 500
