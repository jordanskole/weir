label: Check Style
description: Reviews one revision for style, independently of the fact check
input: Revision
output: StyleReport
examples:
  - given:
      Revision:
        id: "m-1-r1"
        text: "The manuscript"
        round: 1
    expect:
      StyleReport:
        revision_id: "m-1-r1"
        note: "style ok at round 1"
