label: Review Note
description: Both checks for one revision, joined — one per revision, never across revisions
fields:
  revision_id:
    type: utf8
    label: revision_id
    description: The revision both reports were about
    nullable: false
    validations:
      minLength: 1
      maxLength: 100
  # maxLength was 1000, which is 3 short of what this edge promises to carry:
  # StyleReport.note and FactReport.note are each maxLength 500 and the example's
  # format joins them with " | ", so the maximal output is 1003. The node was
  # unimplementable at its own bounds -- found once the allOf generator started
  # producing bags whose revision_ids match, which is what let a correct
  # implementation get far enough to overflow.
  combined:
    type: utf8
    label: combined
    description: The two findings together
    nullable: false
    validations:
      minLength: 1
      maxLength: 1003
