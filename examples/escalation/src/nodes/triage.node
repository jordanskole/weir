label: Triage
description: Resolves the ticket if this tier can, otherwise hands it to the next one
input: Ticket
output:
  oneOf:
    - Resolution
    - Ticket
examples:
  # Tier 1 cannot resolve a difficulty-3 ticket, so it escalates.
  - given:
      Ticket:
        id: "t-1"
        summary: "Cannot sign in after password reset"
        difficulty: 3
        tier: 1
    expect:
      Ticket:
        id: "t-1"
        summary: "Cannot sign in after password reset"
        difficulty: 3
        tier: 2
  # Tier 3 can, which is the branch nothing routes back — the base case.
  - given:
      Ticket:
        id: "t-1"
        summary: "Cannot sign in after password reset"
        difficulty: 3
        tier: 3
    expect:
      Resolution:
        id: "t-1"
        resolved_by_tier: 3
